<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>So, How Was It? ♡</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap');

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    background: #fff0f3;
    font-family: 'DM Sans', sans-serif;
    color: #59474d;
    padding: 35px 15px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow-x: hidden;
}

.container {
    width: 100%;
    max-width: 490px;
    background: #fffdfd;
    border: 1px solid #f8dce3;
    border-radius: 25px;
    padding: 32px 25px;
    box-shadow: 0 15px 45px rgba(206, 132, 153, 0.13);
    animation: appear .6s ease;
}

@keyframes appear {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
}

.top {
    text-align: center;
    margin-bottom: 30px;
}

.emoji {
    font-size: 38px;
    margin-bottom: 15px;
    animation: float 2s infinite ease-in-out;
}

@keyframes float {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
}

.tag {
    display: inline-block;
    background: #fff0f3;
    color: #ce8298;
    padding: 7px 13px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

h1 {
    font-family: 'Playfair Display', serif;
    font-size: 35px;
    font-weight: 500;
    color: #bd718a;
    margin-bottom: 12px;
}

.subtitle {
    font-size: 13px;
    line-height: 1.8;
    color: #a18d94;
}

.divider {
    height: 1px;
    background: #f8e7eb;
    margin: 24px 0;
}

.question {
    margin-bottom: 27px;
    text-align: left;
}

.number {
    color: #d58da2;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.question label {
    display: block;
    color: #654f57;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 13px;
}

.hint {
    color: #b5a2a8;
    font-size: 11px;
    margin-top: -7px;
    margin-bottom: 12px;
}

.options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.option {
    flex: 1;
    min-width: 75px;
    padding: 12px 9px;
    background: #fff8fa;
    border: 1px solid #f2dce3;
    border-radius: 12px;
    color: #866d76;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
    transition: all .2s ease;
}

.option:hover {
    background: #ffedf2;
    border-color: #e8b8c7;
    transform: translateY(-2px);
}

.option.selected {
    background: #dc9caf;
    color: white;
    border-color: #dc9caf;
    box-shadow: 0 4px 10px #dc9caf40;
}

textarea {
    display: block;
    width: 100%;
    min-height: 85px;
    padding: 13px;
    border: 1px solid #f2dce3;
    background: #fff9fa;
    border-radius: 13px;
    outline: none;
    resize: vertical;
    font-family: inherit;
    font-size: 12px;
    color: #59474d;
}

textarea:focus {
    border-color: #d995aa;
    box-shadow: 0 0 0 3px #fce9ee;
}

textarea::placeholder {
    color: #c5afb6;
}

.submit {
    width: 100%;
    background: #d990a6;
    color: white;
    border: none;
    border-radius: 14px;
    padding: 16px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    margin-top: 5px;
    transition: .2s;
}

.submit:hover {
    background: #c77891;
    transform: translateY(-2px);
    box-shadow: 0 7px 15px #d990a640;
}

.footer {
    text-align: center;
    font-size: 11px;
    color: #c3aab3;
    margin-top: 22px;
}

.hidden {
    display: none !important;
}

.thanks {
    text-align: center;
    padding: 45px 20px;
}

.thanks h1 {
    margin: 15px 0;
}

.thanks .emoji {
    font-size: 55px;
}

.small-note {
    font-size: 13px;
    color: #a18d94;
    line-height: 1.8;
    margin-top: 12px;
}

@media(max-width: 400px) {
    .container { padding: 28px 18px; }
    h1 { font-size: 30px; }
    .option { min-width: 65px; }
}
</style>
</head>

<body>

<div class="container" id="survey">

    <div class="top">
        <div class="emoji">♡</div>
        <div class="tag">A VERY IMPORTANT SURVEY</div>

        <h1>So, How Was It?</h1>

        <p class="subtitle">
            Hey! I made a little something for you.
            Just a few questions about our date.
            Be honest, I promise I won't judge. :)
        </p>
    </div>

    <div class="divider"></div>

    <!-- QUESTION 1 -->
    <div class="question">
        <div class="number">QUESTION 01</div>
        <label>Okay, first things first... how was the date?</label>

        <div class="options" data-question="Date rating">
            <button class="option">1</button>
            <button class="option">2</button>
            <button class="option">3</button>
            <button class="option">4</button>
            <button class="option">5</button>
            <button class="option">6</button>
            <button class="option">7</button>
            <button class="option">8</button>
            <button class="option">9</button>
            <button class="option">10</button>
        </div>
        <p class="hint">1 = Never again, 10 = Let's do that again!</p>
    </div>

    <!-- QUESTION 2 -->
    <div class="question">
        <div class="number">QUESTION 02</div>
        <label>Did you actually enjoy my company?</label>

        <div class="options" data-question="Enjoyed my company">
            <button class="option">Of course!</button>
            <button class="option">Yesss</button>
            <button class="option">It was nice :)</button>
            <button class="option">A little awkward</button>
        </div>
    </div>

    <!-- QUESTION 3 -->
    <div class="question">
        <div class="number">QUESTION 03</div>
        <label>What's your favorite part of the date?</label>

        <textarea id="favorite"
        placeholder="I'm curious about this one..."></textarea>
    </div>

    <!-- QUESTION 4 -->
    <div class="question">
        <div class="number">QUESTION 04</div>
        <label>Was I awkward? Be honest HAHAHA</label>

        <div class="options" data-question="Was I awkward">
            <button class="option">A little HAHAHA</button>
            <button class="option">Not at all!</button>
            <button class="option">We're both awkward</button>
            <button class="option">It's cute though</button>
        </div>
    </div>

    <!-- QUESTION 5 -->
    <div class="question">
        <div class="number">QUESTION 05</div>
        <label>Would you be down to hang out again?</label>

        <div class="options" data-question="Second date">
            <button class="option">YESSS ♡</button>
            <button class="option">Definitely!</button>
            <button class="option">Maybe :)</button>
            <button class="option">We'll see</button>
        </div>
    </div>

    <!-- QUESTION 6 -->
    <div class="question">
        <div class="number">QUESTION 06</div>
        <label>Anything you'd like to do next time?</label>

        <textarea id="nextDate"
        placeholder="Maybe somewhere new? Or something fun?"></textarea>
    </div>

    <!-- QUESTION 7 -->
    <div class="question">
        <div class="number">QUESTION 07</div>
        <label>Any last words for your date partner? HAHAHA</label>

        <textarea id="message"
        placeholder="I'll be reading this very carefully..."></textarea>
    </div>

    <button class="submit" onclick="submitSurvey()">
        Submit my answers ♡
    </button>

    <div class="footer">
        made with a little curiosity and a little bit of pink ♡
    </div>

</div>

<!-- THANK YOU SCREEN -->
<div class="container thanks hidden" id="thanks">

    <div class="emoji">💗</div>

    <h1>That's a Wrap!</h1>

    <p class="subtitle" id="thankMessage">
        Thanks for taking the time to answer!
    </p>

    <p class="small-note">
        I had a nice time with you.
        Hopefully, this isn't the last one. :)
    </p>

    <div class="divider"></div>

    <p style="font-size:12px;color:#c28b9d;">
        end of survey. see you soon? ♡
    </p>

</div>

<script>

const answers = {};

document.querySelectorAll(".options").forEach(group => {

    group.querySelectorAll(".option").forEach(button => {

        button.addEventListener("click", () => {

            group.querySelectorAll(".option").forEach(b => {
                b.classList.remove("selected");
            });

            button.classList.add("selected");

            answers[group.dataset.question] =
                button.textContent.trim();

        });

    });

});

function submitSurvey() {

    const required = [
        "Date rating",
        "Enjoyed my company",
        "Was I awkward",
        "Second date"
    ];

    for (const question of required) {

        if (!answers[question]) {
            alert("Hey! You missed a question. Go back and answer it first. ♡");
            return;
        }

    }

    answers["Favorite part"] =
        document.getElementById("favorite").value || "No answer";

    answers["Next date idea"] =
        document.getElementById("nextDate").value || "No answer";

    answers["Last words"] =
        document.getElementById("message").value || "No answer";

    // Save responses in this browser
    localStorage.setItem(
        "dateSurveyResponse",
        JSON.stringify(answers)
    );

    const secondDate = answers["Second date"];

    let message = "Thanks for answering my little survey. I hope you had a nice time! ♡";

    if (secondDate.includes("YES") || secondDate === "Definitely!") {

        message = "Well, looks like someone might be seeing me again. HAHAHA. Looking forward to it! ♡";

    } else if (secondDate === "Maybe :)") {

        message = "No pressure! I'll just have to make the next one even better. :)";

    } else {

        message = "Thank you for being honest! I genuinely appreciate you taking the time to answer. ♡";

    }

    document.getElementById("thankMessage").textContent = message;

    document.getElementById("survey").classList.add("hidden");

    document.getElementById("thanks").classList.remove("hidden");

    window.scrollTo({ top: 0, behavior: "smooth" });

}

</script>

</body>
</html>
